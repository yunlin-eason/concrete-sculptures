---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { isArticle = false } = Astro.props;
---

<header class="sticky top-0 z-50 w-full border-b border-white/15 bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <div class="container mx-auto flex h-16 max-w-5xl items-center justify-between px-4">
    <div class="flex items-baseline gap-3">
      <a href={`${base}literature/`} class="text-lg font-bold tracking-wider">阿峰文學</a>
      <a href={base} class="text-sm tracking-wide text-white/75 transition-colors hover:text-white">雕塑</a>
    </div>
    <nav class="flex gap-6 text-sm font-medium">
      <a href={isArticle ? `${base}literature/` : '#works'} class="transition-colors hover:text-white">作品列表</a>
    </nav>
  </div>
</header>
