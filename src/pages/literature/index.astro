---
import Layout from '../../layouts/Layout.astro';
import LiteratureHeader from '../../components/LiteratureHeader.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout siteTitle="阿峰文學" dark>
  <LiteratureHeader />
  <main id="works" class="mx-auto min-h-[calc(100vh-4rem)] max-w-5xl px-4 py-16 sm:py-24">
    <ul class="space-y-5">
      <li>
        <a href={`${base}literature/renart/`} class="text-xl tracking-wide transition-opacity hover:opacity-60">雷納德</a>
      </li>
    </ul>
  </main>
</Layout>
