---
import Layout from '../../layouts/Layout.astro';
import LiteratureHeader from '../../components/LiteratureHeader.astro';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import manuscript from '../../data/literature/renart.md?raw';

export async function getStaticPaths() {
  return [{ params: { slug: 'renart' } }];
}

const processor = await createMarkdownProcessor({ syntaxHighlight: false });
const { code: content } = await processor.render(manuscript);
---

<Layout title="雷納德" siteTitle="阿峰文學" dark>
  <LiteratureHeader isArticle />
  <main class="mx-auto max-w-2xl px-6 py-16 sm:px-8 sm:py-24">
    <article class="literature-prose">
      <Fragment set:html={content} />
    </article>
  </main>
</Layout>
