---
import '../styles/global.css';
import { siteConfig, gaId } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  siteTitle?: string;
  dark?: boolean;
}

const { title, description, siteTitle = siteConfig.title, dark = false } = Astro.props;
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const pageDesc = description || siteConfig.description;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="zh-Hant" class:list={{ dark }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{pageTitle}</title>
    {gaId && (
      <Fragment>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = window.gtag || function() { window.dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', gaId);

          document.addEventListener('click', (event) => {
            const banner = event.target.closest('[data-ga-banner]');
            if (!banner) return;

            gtag('event', `banner_click_${banner.dataset.gaBanner}`, {
              link_url: banner.href,
            });
          });
        </script>
      </Fragment>
    )}
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <slot />
  </body>
</html>
